# Copy to .env and fill in. Never commit .env.

# API server (defaults shown). In production (NODE_ENV=production, as in the Docker image) the
# host defaults to 0.0.0.0 and Cloud Run's PORT wins over API_PORT; DATABASE_URL, SESSION_SECRET,
# TOKEN_ENCRYPTION_KEY, STRAVA_CLIENT_ID and STRAVA_CLIENT_SECRET are then required.
API_HOST=127.0.0.1
API_PORT=3001

# Postgres (default matches docker-compose.yml)
DATABASE_URL=postgres://mykom:mykom@localhost:5433/mykom

# Signs the session cookie: at least 32 random characters (e.g. `openssl rand -base64 32`).
# Required in production; a development-only default is used when unset.
SESSION_SECRET=

# Encrypts Strava tokens at rest (AES-256-GCM): 32 random bytes, base64 (`openssl rand -base64 32`).
# Required in production; a development-only key is used (with a warning) when unset. Changing it
# makes stored tokens unreadable, so Runners would have to sign in again.
TOKEN_ENCRYPTION_KEY=

# Strava API app credentials (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional: a real Strava token set for the opt-in live tests (never commit it). It seeds the
# git-ignored .strava-live-token.json the first time; after that the file holds the latest token,
# since Strava rotates refresh tokens. `pnpm strava:authorize` writes a fresh one if it's lost.
# STRAVA_TOKEN_EXPIRES_AT is epoch seconds (Strava's expires_at) or an ISO date.
STRAVA_REFRESH_TOKEN=
STRAVA_ACCESS_TOKEN=
STRAVA_TOKEN_EXPIRES_AT=

# User-Agent for Nominatim place search: name the app and give a contact, as its usage policy
# requires (e.g. `myKOM/0.1 (you@example.com)`). Place search is unavailable while unset.
NOMINATIM_USER_AGENT=

# GeoLite2 City database for the "Use my location" IP fallback. `pnpm geolite2:update` downloads
# it with your free MaxMind license key (https://www.maxmind.com/en/geolite2/signup).
# GEOLITE2_CITY_DB is where it lives (relative to the repo root; this default when unset).
# Without the file, IP location just reports itself unavailable.
MAXMIND_LICENSE_KEY=
GEOLITE2_CITY_DB=data/geolite2/GeoLite2-City.mmdb

# Which proxies to trust for the client IP (X-Forwarded-For): comma-separated addresses/CIDRs,
# or `true` to trust any. Leave empty when nothing sits in front of the API.
TRUST_PROXY=

# POST /internal/tick (Cloud Scheduler, every 5 minutes) checks the Google OIDC token it sends:
# its audience must be TICK_OIDC_AUDIENCE (the service URL, e.g. https://mykom-xxxx.run.app) and
# its email TICK_SERVICE_ACCOUNT (the Scheduler's service account). Unset, the route refuses every
# call. Not needed locally: outside production the dev server ticks itself every 5 minutes.
TICK_OIDC_AUDIENCE=
TICK_SERVICE_ACCOUNT=
